# ---------------------------------------------------------------
# Copy this file to server/.env and client/.env as documented.
# The app runs with sensible demo defaults even without any keys.
# ---------------------------------------------------------------

# ---------------- server/.env ----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Supabase (optional in local demo mode, used by database/ SQL scripts in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Razorpay (optional - plan upgrades fall back to demo activation when empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI provider (optional - a deterministic local assistant is used when empty)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Google Calendar / Meet (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Email (optional - reset links are logged/shown in development when empty)
EMAIL_SERVICE_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com

# ---------------- client/.env ----------------
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
