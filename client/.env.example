# API base URL. Leave blank to use the Vite proxy to http://localhost:5000/api.
# VITE_API_BASE_URL=http://localhost:5000/api

# Optional: only needed if you replace the local JSON data layer with Supabase
# in the React client. The demo app does not call Supabase from the browser.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
